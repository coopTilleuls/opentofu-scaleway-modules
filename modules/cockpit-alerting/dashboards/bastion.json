{
  "title": "Bastion - SSH et auditd",
  "uid": "bastion-ssh-auditd",
  "tags": [
    "bastion",
    "ssh",
    "auditd",
    "terraformed"
  ],
  "description": "Connexions SSH (journald) et événements auditd du bastion, envoyés vers Cockpit Loki par Grafana Alloy.",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "loki_ds",
        "label": "Source de logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false
      },
      {
        "name": "host",
        "label": "Bastion",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${loki_ds}"
        },
        "query": {
          "label": "host",
          "stream": "{source=\"auditd\"}",
          "type": 1,
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({source=\"auditd\"}, host)",
        "refresh": 2,
        "sort": 1,
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "user",
        "label": "Utilisateur (regex AUID)",
        "type": "textbox",
        "query": ".+",
        "current": {
          "text": ".+",
          "value": ".+"
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Connexions SSH (journald, unit ssh.service)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Connexions acceptées",
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "${loki_ds}"
      },
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki_ds}"
          },
          "expr": "sum(count_over_time({host=\"$host\", unit=\"ssh.service\"} |= \"Accepted\" [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Échecs d'authentification",
      "id": 3,
      "datasource": {
        "type": "loki",
        "uid": "${loki_ds}"
      },
      "description": "Failed publickey/password, Invalid user, authentication failure (PAM).",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki_ds}"
          },
          "expr": "sum(count_over_time({host=\"$host\", unit=\"ssh.service\"} |~ `Failed \\S+ for|Invalid user|authentication failure` [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Exports pg_dump (auditd)",
      "id": 4,
      "datasource": {
        "type": "loki",
        "uid": "${loki_ds}"
      },
      "description": "Exécutions de pg_dump (clé auditd pg_extract).",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
