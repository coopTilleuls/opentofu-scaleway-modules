        "type": "loki",
        "uid": "${loki_ds}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki_ds}"
          },
          "expr": "sum by (user, ip, method) (count_over_time({host=\"$host\", unit=\"ssh.service\"} |= \"Accepted\" | regexp `Accepted (?P<method>\\S+) for (?P<user>\\S+) from (?P<ip>\\S+)` [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Connexions",
              "user": "Utilisateur",
              "ip": "IP source",
              "method": "Méthode"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Connexions",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "table",
      "title": "Échecs : IP source",
      "id": 9,
      "datasource": {
        "type": "loki",
        "uid": "${loki_ds}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki_ds}"
          },
          "expr": "topk(20, sum by (ip) (count_over_time({host=\"$host\", unit=\"ssh.service\"} |~ `Failed \\S+ for|Invalid user|authentication failure` | regexp `from (?P<ip>[0-9a-fA-F.:]+)` [$__range])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Échecs",
              "ip": "IP source"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Échecs",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
