      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki_ds}"
          },
          "expr": "{host=\"$host\", unit=\"ssh.service\"} |~ `Accepted|Failed|Invalid user|Disconnected from|session (opened|closed)|Connection closed`",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
