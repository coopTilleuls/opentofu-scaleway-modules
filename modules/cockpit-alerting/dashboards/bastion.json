            "fixedColor": "purple"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Modifs de config sensible (auditd)",
      "id": 5,
      "datasource": {
        "type": "loki",
        "uid": "${loki_ds}"
      },
      "description": "Écritures sur sudoers, sshd_config, passwd/shadow/group, /etc/audit (clés sudoers, sshd, identity, audit_config).",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki_ds}"
          },
          "expr": "sum(count_over_time({host=\"$host\", source=\"auditd\"} |~ `key=\"(sudoers|sshd|identity|audit_config)\"` [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
